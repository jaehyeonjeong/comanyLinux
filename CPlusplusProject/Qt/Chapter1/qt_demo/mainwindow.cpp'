// ~/qt_demo/mainwindow.cpp

MainWindow::MainWindow(QWidget *parent) : QWidget(parent) {
    // 1. UI 디자인 설정
    setWindowTitle("키오스크 모드 Qt Demo");
    
    // [핵심 코드] 이 창을 모니터 전체 화면으로 채웁니다.
    // 윈도우 테두리와 타이틀 바가 자동으로 제거됩니다.
    showFullScreen(); 

    m_button = new QPushButton("키오스크 버튼 (클릭하세요)", this);
    
    // 버튼 크기를 키오스크 스타일처럼 큼직하게 설정 (예: 가로 300, 세로 100)
    m_button->setFixedSize(300, 100); 

    m_layout = new QVBoxLayout(this);
    m_layout->addWidget(m_button, 0, Qt::AlignCenter); // 화면 정중앙에 배치
    setLayout(m_layout);

    connect(m_button, &QPushButton::clicked, this, &MainWindow::onButtonClicked);
}
