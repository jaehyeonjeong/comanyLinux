<Application x:Class="ServoControlWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- StartupUri 를 쓰지 않고 App.xaml.cs 의 OnStartup 에서 Model → ViewModel → View 를 직접 조립한다 (Qt 의 main.cpp 역할) -->
    <Application.Resources>
        <!-- Qt 스타일시트에 해당하는 기본 모양 -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="#CCD1D9" />
            <Setter Property="Background" Value="White" />
        </Style>
        <!-- GroupBox 안의 내용은 다시 보통 굵기로 -->
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0B3D63" />
        </Style>
        <Style x:Key="PulseText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style x:Key="ReleaseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="BorderBrush" Value="#8E1B1B" />
        </Style>
    </Application.Resources>
</Application>
