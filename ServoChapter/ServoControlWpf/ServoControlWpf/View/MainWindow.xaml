<Window x:Class="ServoControlWpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ServoControlWpf.View"
        xmlns:vm="clr-namespace:ServoControlWpf.ViewModel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1320" Height="800" MinWidth="1120" MinHeight="660"
        FontSize="15" Background="#F7F8FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 키보드: ←/→ = 1° 이동, Space = 출력 끄기, F11 = 전체화면 -->
    <Window.InputBindings>
        <KeyBinding Key="Left"  Command="{Binding NudgeCommand}" CommandParameter="-1" />
        <KeyBinding Key="Right" Command="{Binding NudgeCommand}" CommandParameter="1" />
        <KeyBinding Key="Space" Command="{Binding ReleaseCommand}" />
        <KeyBinding Key="F11"   Command="{x:Static v:MainWindow.ToggleFullScreenCommand}" />
    </Window.InputBindings>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────── 상단: 제목 + 연결 ───────── -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TitleText}" Text="서보 원격 제어" VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="연결 방식" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="120" SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding CanEditConnection}"
                          ToolTip="{Binding ConnectHint}" AutomationProperties.Name="연결 방식">
                    <ComboBoxItem Content="직접 연결" />
                    <ComboBoxItem Content="WSL 터널" />
                    <ComboBoxItem Content="에뮬레이터" />
                </ComboBox>

                <!-- 에뮬레이터: 하드웨어 없이 가짜 Pi 에 접속 — 앱 안 / WSL 의 fake_pigpiod.py -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsEmulatorMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="종류" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <!-- 설명은 툴팁으로 (연결 바가 길어져 창이 좁을 때 버튼이 밀리는 것을 막음) -->
                    <ComboBox MinWidth="150" SelectedIndex="{Binding EmulatorKindIndex}" IsEnabled="{Binding CanEditConnection}"
                              ToolTip="{Binding EmulatorKindHint}" AutomationProperties.Name="에뮬레이터 종류">
                        <ComboBoxItem Content="앱 안 가짜 Pi" ToolTip="앱 안에서 가짜 pigpiod 를 127.0.0.1 에 띄움 — 준비물 없음" />
                        <ComboBoxItem Content="WSL 가짜 Pi (fake_pigpiod.py)" ToolTip="WSL 에 리눅스 가짜 pigpiod 를 띄우고 127.0.0.1 로 접속 — 명령이 가상 네트워크를 실제로 건너감. 이미 떠 있으면 그것 사용" />
                    </ComboBox>
                </StackPanel>

                <!-- 직접 연결: Pi 주소 -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirectMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Pi 주소" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Width="150" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}"
                             AutomationProperties.Name="Pi 주소" ToolTip="실제 Pi 의 LAN 주소 (127.0.0.1 등 자기 주소는 에뮬레이터에서)" />
                </StackPanel>

                <!-- WSL 터널: ssh 별명 · 배포판 · 로컬 포트 -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTunnelMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ssh 별명" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Width="80" Text="{Binding Wsl.SshAlias, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditConnection}" />
                    <TextBlock Text="배포판" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox Width="120" IsEditable="True" ItemsSource="{Binding Wsl.Distros}"
                              Text="{Binding Wsl.Distro, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditConnection}"
                              ToolTip="비우면 WSL 기본 배포판" />
                    <TextBlock Text="로컬 포트" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Width="60" Text="{Binding TunnelLocalPort}" IsEnabled="{Binding CanEditConnection}" />
                </StackPanel>

                <TextBlock Text="Pi 포트" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="60" Text="{Binding Port}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Pi 포트" />

                <Button Margin="10,0,0,0" MinWidth="96" Content="{Binding ConnectButtonText}" Command="{Binding ConnectToggleCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="#1A7F37" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="전체화면 (F11)" Command="{x:Static v:MainWindow.ToggleFullScreenCommand}" Margin="8,0,0,0" />
                <Button Content="종료" Click="OnQuitClick" Margin="8,0,0,0" />
            </StackPanel>
            <Border />
        </DockPanel>

        <!-- ───────── 연결 정보 줄: 창 폭 전체를 쓰고, 긴 글은 글꼴을 줄이거나(ShrinkTextBlock) … + 툴팁 ───────── -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="●" FontSize="18" VerticalAlignment="Center" Margin="2,0,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#9E9E9E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Foreground" Value="#1A7F37" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <v:ShrinkTextBlock Grid.Column="1" Text="{Binding DriverName}" VerticalAlignment="Center" MaxWidth="380" MinFontSize="11" />
            <v:ShrinkTextBlock Grid.Column="2" Text="{Binding ConnInfoText}" Foreground="Gray" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="320" MinFontSize="11" />
            <v:ShrinkTextBlock Grid.Column="3" Text="{Binding EmulatorText}" Foreground="#7A4F01" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" MinFontSize="10"
                               Visibility="{Binding IsEmulatorMode, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ───────── 본문 ───────── -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 위 = 실제 카메라 영상(노트북 웹캠, 나중에 Pi 카메라), 아래 = 서보에 올려진 카메라의 움직임(표시 전용) -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="카메라 화면" Margin="0,0,0,8" DataContext="{Binding Camera}">
                    <DockPanel Margin="4">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="카메라" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button DockPanel.Dock="Right" Content="새로 고침" Command="{Binding RefreshCommand}" Margin="6,0,0,0" ToolTip="카메라 장치 목록을 다시 읽습니다" />
                            <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Margin="6,0,0,0" MinWidth="56" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsText}" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                                      ToolTip="기본값은 첫 번째 장치(노트북 내장 카메라). 'Pi 카메라 (네트워크)' 는 Pi 의 pi_display 가 내보내는 MJPEG 스트림" />
                        </DockPanel>
                        <!-- 네트워크 카메라를 골랐을 때만: 스트림 URL (비우면 Pi 주소에서 자동) -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                   Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="URL" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="12"
                                       Text="{Binding DataContext.PiCameraUrlHint, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='비우면 {0}'}" />
                            <TextBox Text="{Binding PiCameraUrl, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="예: http://172.30.1.81:8889/stream.mjpg — 비우면 연결 설정의 Pi 주소와 포트 8889 로 자동" />
                        </DockPanel>
                        <!-- Pi 카메라(네트워크)일 때만: 녹화 · 사진 (pi_display 의 HTTP API). 설정·인식·전송은 오른쪽 "Pi 카메라" 탭 -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4"
                                    Visibility="{Binding IsPiPanelVisible, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{Binding RecordText}" Command="{Binding RecordCommand}" MinWidth="88" Padding="8,3"
                                        AutomationProperties.Name="녹화" Foreground="#B00020" FontWeight="Bold"
                                        ToolTip="Pi 에서 녹화를 시작/정지합니다. picamera2 면 1080p30 등 녹화 모드 크기로 H.264 하드웨어 인코딩(mp4), 그 밖의 백엔드는 미리보기 MJPEG 를 AVI 로. 정지하면 WSL 로 자동 가져옵니다." />
                                <Button DockPanel.Dock="Left" Content="📷 사진" Command="{Binding SnapshotCommand}" Margin="6,0,0,0" Padding="8,3"
                                        AutomationProperties.Name="사진" ToolTip="OV5647 최대 해상도(2592×1944, 5 MP)로 한 장 저장 (녹화 중이면 녹화 해상도). 스트림이 약 1 초 멈출 수 있음" />
                                <v:ShrinkTextBlock Text="{Binding DetectText}" Foreground="#2E7D32" FontSize="12" MinFontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding IsDetectOn, Converter={StaticResource BoolToVis}}" />
                            </DockPanel>
                            <v:ShrinkTextBlock Text="{Binding RecordInfoText}" Foreground="#555" FontSize="12" MinFontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                        <v:ShrinkTextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="Gray" FontSize="12" MinFontSize="10" Margin="0,4,0,0" />
                        <Border Background="#141618" CornerRadius="6">
                            <Grid>
                                <Image Source="{Binding Frame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                                <TextBlock Text="{Binding OverlayText}" Foreground="#BBB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="16" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </GroupBox>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                    <v:ServoCameraView MinAngle="{Binding MinAngle}" MaxAngle="{Binding MaxAngle}"
                                       Angle="{Binding Angle, Mode=OneWay}" IsOutputOn="{Binding IsOutputOn}" Pulse="{Binding Pulse}"
                                       IsConnected="{Binding IsConnected}"
                                       IsHitTestVisible="False" />
                </Border>
            </Grid>

            <!-- 가운데: 다이얼 조종 -->
            <GroupBox Grid.Column="1" Header="다이얼 조종" Margin="0,0,8,0">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ReleaseButton}" Content="출력 끄기 (Space)"
                            Command="{Binding ReleaseCommand}" Margin="0,8,0,0" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Content="◀ 최소" Command="{Binding GoMinCommand}" Margin="0,0,3,0" />
                        <Button Content="최대 ▶" Command="{Binding GoMaxCommand}" Margin="3,0,0,0" />
                    </UniformGrid>
                    <!-- 좁은 창에서도 "−10°" 가 잘리지 않게 안쪽 여백을 줄임 -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="5" Margin="0,6,0,0">
                        <Button Content="−10°" Command="{Binding NudgeCommand}" CommandParameter="-10" Margin="0,0,2,0" Padding="2,4" />
                        <Button Content="−1°"  Command="{Binding NudgeCommand}" CommandParameter="-1" Margin="2,0" Padding="2,4" />
                        <Button Content="0°"   Command="{Binding CenterCommand}" Margin="2,0" FontWeight="Bold" Padding="2,4" />
                        <Button Content="+1°"  Command="{Binding NudgeCommand}" CommandParameter="1" Margin="2,0" Padding="2,4" />
                        <Button Content="+10°" Command="{Binding NudgeCommand}" CommandParameter="10" Margin="2,0,0,0" Padding="2,4" />
                    </UniformGrid>
                    <v:ShrinkTextBlock DockPanel.Dock="Bottom" Text="{Binding OutputText}" HorizontalAlignment="Center" Margin="0,4,0,0" MinFontSize="11" />

                    <!-- 각도 ↔ 펄스폭: 어느 쪽을 바꿔도 다른 쪽과 서보 출력이 따라 바뀜 -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="각도" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="AngleSlider" Minimum="{Binding MinAngle}" Maximum="{Binding MaxAngle}"
                                Value="{Binding Angle, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                PreviewMouseWheel="OnSliderWheel" ToolTip="각도 슬라이더 (휠 1칸 = 1°)" />
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="AngleBox" Width="90" MinHeight="34" FontSize="17" TextAlignment="Center" Margin="8,2,0,2"
                                 Text="{Binding Angle, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="OnInputBoxKeyDown" ToolTip="각도를 입력하고 Enter → 펄스폭이 따라 바뀜" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="°" FontSize="17" VerticalAlignment="Center" Margin="4,0,0,0" Width="26" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="펄스" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="PulseSlider" Minimum="{Binding MinPulse}" Maximum="{Binding MaxPulse}"
                                Value="{Binding PulseInput, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="100" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                SmallChange="10" LargeChange="100" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                PreviewMouseWheel="OnPulseSliderWheel" ToolTip="펄스폭 슬라이더 (휠 1칸 = 10 µs) → 각도가 따라 바뀜" />
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="PulseBox" Width="90" MinHeight="34" FontSize="17" TextAlignment="Center" Margin="8,2,0,2"
                                 Text="{Binding PulseInput, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="OnInputBoxKeyDown" ToolTip="펄스폭(µs)을 입력하고 Enter → 각도가 따라 바뀜" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="µs" FontSize="15" VerticalAlignment="Center" Margin="4,0,0,0" Width="26" />
                    </Grid>

                    <!-- 다이얼 (QDial 에 해당): 노브를 끌어 돌리거나, 휠 한 칸 = 1°, ←/→ = 1°, PgUp/PgDn = 10° -->
                    <v:ServoDial x:Name="AngleDial" Margin="4"
                                 Minimum="{Binding MinAngle}" Maximum="{Binding MaxAngle}"
                                 Value="{Binding Angle, Mode=TwoWay}" IsOutputOn="{Binding IsOutputOn}" Pulse="{Binding Pulse}"
                                 ToolTip="노브를 끌어 돌리기 · 휠 1칸 = 1° · ←/→ 1° · PgUp/PgDn 10° · Home/End 끝" />
                </DockPanel>
            </GroupBox>

            <!-- 오른쪽: 탭 (서보 / WSL·Pi 관리) -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="  서보  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4">
                            <!-- 해제·종료 시 출력 유지: 서보가 위치를 지키고, 다음에 연결하면(다시 실행해도) pigpiod 의 현재 펄스(GPW)를 읽어 화면을 맞춤 -->
                            <CheckBox Margin="4,2,4,8" IsChecked="{Binding KeepOutputOnDisconnect}"
                                      ToolTip="끄면 [연결 해제]·종료 때 펄스 0 을 보내 서보 힘을 뺍니다. 그래도 마지막 각도는 저장되어 다음 실행 때 화면이 그 각도에서 시작합니다.">
                                <TextBlock TextWrapping="Wrap" Text="연결 해제·종료 시 서보 출력 유지 — 서보가 자리를 지키고, 다음에 연결하면(다시 실행해도) 그 위치로 화면을 맞춤" />
                            </CheckBox>

                            <!-- 위치 메모리 -->
                            <GroupBox Header="위치 메모리 (누르면 이동)">
                                <ItemsControl ItemsSource="{Binding Presets}" Margin="4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PresetSlot}">
                                            <StackPanel Margin="3">
                                                <Button Style="{StaticResource PresetButton}" Content="{Binding Label}" IsEnabled="{Binding HasValue}"
                                                        Command="{Binding DataContext.PresetRecallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Index}" />
                                                <Button Content="현재 위치 저장" FontSize="12" Padding="4" Margin="0,4,0,0"
                                                        Command="{Binding DataContext.PresetStoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Index}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <!-- 스윕 -->
                            <GroupBox Header="스윕 (최소 ↔ 최대 왕복)">
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Left" MinWidth="100" Content="{Binding SweepButtonText}" Command="{Binding ToggleSweepCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSweeping}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SweepSpeedText}" MinWidth="70" VerticalAlignment="Center" TextAlignment="Right" />
                                    <Slider Minimum="5" Maximum="200" Value="{Binding SweepSpeed}" TickFrequency="5" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="8,0" ToolTip="°/s (HS-311 최대 약 315°/s @4.8V)" />
                                </DockPanel>
                            </GroupBox>

                            <!-- 보정 -->
                            <GroupBox Header="보정 (자동 저장)">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="신호 핀 (BCM)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding CalGpio}" Margin="0,0,0,4" ToolTip="GPIO 2~27 (기본 18 = 물리 12번 핀)" />
                                    <TextBlock Grid.Row="1" Text="1° 당 µs" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding CalUsPerDeg}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" AutomationProperties.Name="1도당 µs"
                                               ToolTip="각도 ↔ 펄스를 잇는 기울기 (HS-311 공식 10 µs/°). 바꾸면 각도를 지킨 채 최소·최대 펄스가 다시 계산됩니다" />
                                    <TextBlock Grid.Row="2" Text="중립 펄스 (µs)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding CalNeutralPulse}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" ToolTip="0° 의 펄스폭. 바꾸면 각도를 지킨 채 최소·최대 펄스가 따라 움직입니다" />
                                    <TextBlock Grid.Row="3" Text="최소 각도 (°)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding CalMinAngle}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" AutomationProperties.Name="최소 각도" ToolTip="고치면 최소 펄스 = 중립 + 각도 × 기울기 로 따라 바뀜 (Enter 또는 다른 칸으로 이동하면 반영)" />
                                    <TextBlock Grid.Row="4" Text="최소 펄스 (µs)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding CalMinPulse}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" AutomationProperties.Name="최소 펄스" ToolTip="고치면 최소 각도 = (펄스 − 중립) ÷ 기울기 로 따라 바뀜" />
                                    <TextBlock Grid.Row="5" Text="최대 각도 (°)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding CalMaxAngle}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" AutomationProperties.Name="최대 각도" ToolTip="고치면 최대 펄스가 따라 바뀜" />
                                    <TextBlock Grid.Row="6" Text="최대 펄스 (µs)" VerticalAlignment="Center" Margin="0,0,10,4" />
                                    <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding CalMaxPulse}" Margin="0,0,0,4" KeyDown="OnInputBoxKeyDown" AutomationProperties.Name="최대 펄스" ToolTip="고치면 최대 각도가 따라 바뀜" />
                                    <v:ShrinkTextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding CalLinkText}" Foreground="Gray" FontSize="12" MinFontSize="10" Margin="0,2,0,0" />
                                    <UniformGrid Grid.Row="8" Grid.ColumnSpan="2" Columns="3" Margin="0,6,0,0">
                                        <Button Content="적용" Command="{Binding ApplySpecCommand}" Margin="0,0,3,0" FontWeight="Bold" />
                                        <Button Content="공식값 ±40°" Command="{Binding ApplyOfficialCommand}" Margin="3,0" />
                                        <Button Content="확장값 ±90°" Command="{Binding ApplyExtendedCommand}" Margin="3,0,0,0" />
                                    </UniformGrid>
                                </Grid>
                            </GroupBox>

                            <TextBlock Margin="6,10,6,0" Foreground="Gray" TextWrapping="Wrap" FontSize="13"
                                       Text="배선: 노랑(신호) → 12번 핀(GPIO18), 빨강 → 외부 5 V, 검정 → 외부 전원 − 와 Pi GND(6번) 공통. 서보 전원을 Pi 5 V 핀에서 직접 뽑지 마세요." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pi 카메라(OV5647) 설정 · 인식 · 녹화 전송. 카메라 패널 안에 두면 영상 영역이 줄어들어 탭으로 분리 -->
                <TabItem Header="  Pi 카메라  " DataContext="{Binding Camera}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="13" Margin="2,2,2,6"
                                       Text="카메라 콤보에서 'Pi 카메라 (네트워크)' 를 골라 영상이 들어올 때 조작할 수 있습니다. 값은 Pi 의 ~/.config/pi_display/camera.json 에 저장되어 다음 실행에도 유지됩니다." />
                            <v:ShrinkTextBlock Text="{Binding PiSettingsInfo}" Foreground="#555" FontSize="12" MinFontSize="10" Margin="2,0,2,2" />
                            <v:ShrinkTextBlock Text="{Binding CalibText}" Foreground="#555" FontSize="12" MinFontSize="10" Margin="2,0,2,6"
                                               ToolTip="Pi 화면 프로그램(pi_display)이 서보 이동 로그의 각도를 계산할 때 쓰는 보정값. 펄스폭은 같아도 보정값이 다르면 각도 숫자가 달라지므로 WPF 의 보정 탭 값과 자동으로 맞춥니다" />

                            <GroupBox Header="카메라 설정 (OV5647 · 5 MP)" Padding="6">
                                <Grid IsEnabled="{Binding CanControlPi}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="녹화 모드" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding RecordModes}" SelectedItem="{Binding RecordMode}" Margin="0,0,0,4"
                                              AutomationProperties.Name="녹화 모드"
                                              ToolTip="1080p30 = 1920×1080 30 fps (Pi 4 H.264 인코더 상한) · 720p60 · 480p90 (빠른 팬 동작 관찰). 바꾸면 카메라를 다시 열어 미리보기가 잠깐 끊김 — 녹화 중에는 못 바꿈" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="화이트밸런스" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding AwbModes}" SelectedItem="{Binding Awb}" Margin="0,0,0,4"
                                              ToolTip="auto · daylight(맑은 날) · cloudy(흐림) · tungsten(백열등) · fluorescent(형광등) · indoor(실내)" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="밝기" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Brightness}" VerticalAlignment="Center"
                                            AutomationProperties.Name="밝기" ToolTip="-1 ~ +1 (0 = 보통)" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0.00}}" Width="40" VerticalAlignment="Center" FontFamily="Consolas" Margin="6,0,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="대비" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Contrast}" VerticalAlignment="Center"
                                            AutomationProperties.Name="대비" ToolTip="0 ~ 2 (1 = 보통)" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0.0}}" Width="40" VerticalAlignment="Center" FontFamily="Consolas" Margin="6,0,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="채도" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Saturation}" VerticalAlignment="Center"
                                            AutomationProperties.Name="채도" ToolTip="0 ~ 2 (1 = 보통, 0 = 흑백)" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:0.0}}" Width="40" VerticalAlignment="Center" FontFamily="Consolas" Margin="6,0,0,0" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox Content="좌우 반전" IsChecked="{Binding Hflip}" Margin="0,0,14,0" ToolTip="카메라를 거꾸로/뒤집어 달았을 때. 카메라를 다시 엽니다" />
                                        <CheckBox Content="상하 반전" IsChecked="{Binding Vflip}" ToolTip="카메라를 다시 엽니다" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="인체 · 사물 인식 (OpenCV)" Padding="6" Margin="0,8,0,0">
                                <StackPanel>
                                    <CheckBox Content="인식 켜기 — 미리보기에 박스와 이름 표시" IsChecked="{Binding IsDetectOn}" IsEnabled="{Binding CanControlPi}" AutomationProperties.Name="인식"
                                              ToolTip="Pi 의 OpenCV(MobileNet-SSD 20종 또는 HOG 사람 검출)로 찾아 미리보기에 그립니다. 녹화 원본(H.264)에는 들어가지 않음. 추론은 별도 스레드라 미리보기는 계속 10 fps" />
                                    <v:ShrinkTextBlock Text="{Binding DetectText}" Foreground="#2E7D32" FontSize="12" MinFontSize="10" Margin="0,4,0,0" />
                                    <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="모델은 install_pi_deps.sh 가 ~/.local/share/pi_display/models/ 에 내려받습니다 (없으면 HOG 로 사람만). Pi 4 에서 약 3~5 fps." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="녹화 파일 전송 (Pi → WSL)" Padding="6" Margin="0,8,0,0"
                                      DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="WSL2 는 NAT 뒤에 있어 Pi 가 보낼 수 없으므로 WSL 이 ssh 별명으로 끌어옵니다(rsync). 쓰는 중인 *.part 는 건너뜁니다." />
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="WSL 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding Wsl.RecordingsDir, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="기본 ~/MyJob/projects/comanyLinux/ServoChapter/recordings — Windows 에서는 \\wsl.localhost\배포판\home\…" />
                                    </DockPanel>
                                    <CheckBox Content="녹화를 멈추거나 사진을 찍으면 바로 가져오기" IsChecked="{Binding AutoPullRecordings}" Margin="0,0,0,6"
                                              ToolTip="끄면 Pi 에만 남고, [지금 가져오기] 나 감시 서비스가 가져옵니다" />
                                    <UniformGrid Columns="2">
                                        <Button Content="지금 가져오기" Command="{Binding Wsl.PullRecordingsCommand}" Margin="0,0,2,2" Padding="4,6"
                                                ToolTip="pull_recordings.sh: Pi 의 ~/Videos/pi_display 에서 새 파일을 rsync 로" />
                                        <Button Content="폴더 열기" Command="{Binding OpenRecordingsFolderCommand}" Margin="2,0,0,2" Padding="4,6"
                                                ToolTip="WSL 의 녹화 폴더를 Windows 탐색기로 엽니다" />
                                        <Button Content="감시 서비스 설치" Command="{Binding Wsl.InstallWatchCommand}" Margin="0,2,2,0" Padding="4,6"
                                                ToolTip="watch_recordings.sh --install: WSL 의 systemd user 서비스로 30 초마다 가져오기 (WPF 가 꺼져 있어도, sudo 불필요)" />
                                        <Button Content="감시 상태" Command="{Binding Wsl.WatchStatusCommand}" Margin="2,2,0,0" Padding="4,6"
                                                ToolTip="watch_recordings.sh --status: 서비스 동작 여부와 최근 가져오기 기록 (결과는 WSL / Pi 관리 탭 로그)" />
                                    </UniformGrid>
                                    <v:ShrinkTextBlock Text="{Binding Wsl.LastPullSummary}" Foreground="#555" FontSize="12" MinFontSize="10" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="  WSL / Pi 관리  " DataContext="{Binding Wsl}">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Content="WSL 확인" Command="{Binding ProbeCommand}" />
                                <TextBlock Text="{Binding WslStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="13" />
                            </DockPanel>

                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="배포판" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" IsEditable="True" ItemsSource="{Binding Distros}"
                                          Text="{Binding Distro, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4" ToolTip="비우면 기본 배포판" />
                                <TextBlock Grid.Row="1" Text="ssh 별명" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SshAlias, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"
                                         ToolTip="WSL 의 ~/.ssh/config 에 있는 Host 이름 (기본 rpi)" />
                                <TextBlock Grid.Row="2" Text="스크립트 폴더" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ScriptDir, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="pi_setup.sh · pi_info.sh 가 있는 폴더 (기본 tools\pi, Windows 경로 또는 /home/... WSL 경로)" />
                                <Button Grid.Row="2" Grid.Column="2" Content="찾기…" Command="{Binding BrowseScriptDirCommand}" Margin="4,0,0,0" Padding="6,4" />
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Content="Pi 화면 배포" Command="{Binding RunDeployPiDisplayCommand}" Margin="0,0,2,0" Padding="4,8"
                                        ToolTip="pi_display(카메라 영상 + 이동 로그 프로그램)를 Pi 로 전송하고 모니터에 띄웁니다 (rsync → 실행 → 상태 확인)" />
                                <Button Content="Pi 화면 배포(+apt) ↗" Command="{Binding OpenDeployPiDisplayTerminalCommand}" Margin="2,0,0,0" Padding="4,8"
                                        ToolTip="처음 한 번: 필요한 패키지(PyQt5·picamera2·pigpio·ffmpeg·OpenCV·인식 모델)를 apt 로 설치하고 자동 시작까지 등록합니다. sudo 비밀번호를 물을 수 있어 새 터미널 창에서 실행" />
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,4,0,4">
                                <Button Content="Pi 상태 확인" Command="{Binding CheckPiCommand}" Margin="0,0,2,0" Padding="4,8"
                                        ToolTip="ssh rpi 로 호스트·IP·pigpiod 상태·온도를 읽어 옵니다" />
                                <Button Content="pi_info.sh" Command="{Binding RunPiInfoCommand}" Margin="2,0" Padding="4,8"
                                        ToolTip="Pi 하드웨어·OS 정보를 모아 pi_info.txt 로 저장하고 보여 줍니다" />
                                <Button Content="pi_setup.sh ↗" Command="{Binding OpenSetupTerminalCommand}" Margin="2,0" Padding="4,8"
                                        ToolTip="새 터미널 창에서 실행 (sudo 비밀번호가 필요할 수 있음)" />
                                <Button Content="취소" Command="{Binding CancelCommand}" Margin="2,0,0,0" Padding="4,8" />
                            </UniformGrid>

                            <DockPanel Margin="0,2,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="ssh rpi" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button DockPanel.Dock="Right" Content="실행" Command="{Binding RunSshCommand}" Margin="4,0,0,0" />
                                <TextBox Text="{Binding SshCommandText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" KeyDown="OnSshBoxKeyDown"
                                         ToolTip="Pi 에서 실행할 명령 (예: pigs s 18 1500)" />
                            </DockPanel>
                        </StackPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="로그 지우기" Command="{Binding ClearLogCommand}" Padding="8,4" />
                            <TextBlock Text="{Binding IsRunning, StringFormat=실행 중: {0}}" Foreground="Gray" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>

                        <TextBox x:Name="WslLog" IsReadOnly="True" Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="13"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="#1E1E1E" Foreground="#D4D4D4"
                                 TextChanged="OnLogChanged" Padding="6" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ───────── 상태 바 ───────── -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4" Background="#ECEFF3" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Foreground="Gray" Margin="12,0,0,0"
                           ToolTip="프로그램 버전 (VERSION 파일 · CHANGELOG.md)" />
                <v:ShrinkTextBlock Text="{Binding StatusText}" MinHeight="20" MinFontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
