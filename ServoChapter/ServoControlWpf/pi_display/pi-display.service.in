[Unit]
Description=Pi servo camera display / MJPEG server (pi_display)
After=network-online.target pigpiod.service graphical.target
Wants=pigpiod.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/Source/pi_display
Environment=DISPLAY=:0
Environment=XAUTHORITY=@HOME@/.Xauthority
# 화면 세션이 없을 수 있으므로 서비스는 --no-gui (서버·로그만). 모니터 화면은 autostart(.desktop)로.
ExecStart=/usr/bin/python3 @HOME@/Source/pi_display/pi_display.py --no-gui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
